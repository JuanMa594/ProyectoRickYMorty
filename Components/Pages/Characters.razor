@page "/characters"
@rendermode InteractiveServer
@using ProyectoRickYMorty.Services;
@using ProyectoRickYMorty.Models;
@inject IRickMortyService ApiService

<PageTitle>Personajes de Rick Y Morty</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="text-center mb-3">
                Personajes <span class="text-primary">Rick</span> Y <span class="text-success">Morty</span>
            </h1>
        </div>
    </div>
    <!-- Barra de filtros -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-funnel-fill me-2"></i>Filtros
                    </h5>
                    
                    <div class="row g-3">
                        <!-- Filtro por Nombre -->
                        <div class="col-md-4">
                            <label for="filterName" class="form-label fw-semibold">
                                <i class="bi bi-search me-1"></i>Nombre
                            </label>
                            <input type="text" 
                                   class="form-control" 
                                   id="filterName"
                                   placeholder="Ej: Rick, Morty..."
                                   @bind="filterName"
                                   @bind:event="oninput" />
                        </div>

                        <!-- Filtro por Estado -->
                        <div class="col-md-4">
                            <label for="filterStatus" class="form-label fw-semibold">
                                <i class="bi bi-heart-pulse-fill me-1"></i>Estado
                            </label>
                            <select class="form-select" 
                                    id="filterStatus"
                                    @bind="filterStatus">
                                <option value="">Todos</option>
                                <option value="alive">Vivo</option>
                                <option value="dead">Muerto</option>
                                <option value="unknown">Desconocido</option>
                            </select>
                        </div>

                        <!-- Filtro por Especie -->
                        <div class="col-md-4">
                            <label for="filterSpecies" class="form-label fw-semibold">
                                <i class="bi bi-diagram-3-fill me-1"></i>Especie
                            </label>
                            <input type="text" 
                                   class="form-control" 
                                   id="filterSpecies"
                                   placeholder="Ej: Human, Alien..."
                                   @bind="filterSpecies"
                                   @bind:event="oninput" />
                        </div>
                    </div>

                    <!-- Botones de acción -->
                    <div class="row mt-3">
                        <div class="col-12 d-flex gap-2 justify-content-end">
                            <button class="btn btn-primary" 
                                    @onclick="ApplyFilters"
                                    disabled="@loading">
                                <i class="bi bi-search me-1"></i>
                                Buscar
                            </button>
                            <button class="btn btn-outline-secondary" 
                                    @onclick="ClearFilters"
                                    disabled="@loading">
                                <i class="bi bi-x-circle me-1"></i>
                                Limpiar
                            </button>
                        </div>
                    </div>

                    <!-- Mensaje de resultados -->
                    @if (!string.IsNullOrEmpty(filterName) || !string.IsNullOrEmpty(filterStatus) || !string.IsNullOrEmpty(filterSpecies))
                    {
                        <div class="alert alert-info mt-3 mb-0 d-flex align-items-center" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            <span>
                                Mostrando <strong>@totalCharacters</strong> resultados
                                @if (!string.IsNullOrEmpty(filterName))
                                {
                                    <span> con nombre "<strong>@filterName</strong>"</span>
                                }
                                @if (!string.IsNullOrEmpty(filterStatus))
                                {
                                    <span> | Estado: <strong>@GetStatusLabel(filterStatus)</strong></span>
                                }
                                @if (!string.IsNullOrEmpty(filterSpecies))
                                {
                                    <span> | Especie: <strong>@filterSpecies</strong></span>
                                }
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando personajes...</p>
        </div>
    }
    else if (characters != null && characters.Any())
    {
        <!-- Grid de personajes -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4 mb-4">
            @foreach (var character in characters)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm character-card">
                        <!-- Imagen -->
                        <div class="position-relative">
                            <img src="@character.Image" 
                                 class="card-img-top" 
                                 alt="@character.Name"
                                 loading="lazy">
                            
                            <!-- Badge de estado -->
                            <span class="badge position-absolute top-0 end-0 m-2 @GetStatusBadgeClass(character.Status)">
                                @character.Status
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <!-- Nombre -->
                            <h5 class="card-title text-truncate" title="@character.Name">
                                @character.Name
                            </h5>

                            <!-- Info del personaje -->
                            <div class="mb-3 flex-grow-1">
                                <p class="card-text mb-1">
                                    <small class="text-muted">
                                        <i class="bi bi-person-square"></i>
                                        <strong>Especie:</strong> @character.Species
                                    </small>
                                </p>
                                
                                @if (!string.IsNullOrEmpty(character.Type))
                                {
                                    <p class="card-text mb-1">
                                        <small class="text-muted">
                                            <i class="bi bi-tag-fill"></i> 
                                            <strong>Tipo:</strong> @character.Type
                                        </small>
                                    </p>
                                }

                                <p class="card-text mb-0">
                                    <small class="text-muted">
                                        <i class="bi bi-gender-ambiguous"></i> 
                                        <strong>Género:</strong> @character.Gender
                                    </small>
                                </p>
                            </div>

                            <!-- Puntaje -->
                            <div class="text-center mb-2">
                                <span class="badge bg-secondary fs-6">
                                    Puntaje: @GetScore(character.Id)
                                </span>
                            </div>

                            <!-- Botones Like/Dislike -->
                            <div class="d-flex gap-2">
                                <button class="btn btn-success flex-fill" 
                                        @onclick="() => HandleLike(character.Id)">
                                    <i class="bi bi-hand-thumbs-up-fill"></i> Like
                                </button>
                                <button class="btn btn-danger flex-fill" 
                                        @onclick="() => HandleDislike(character.Id)">
                                    <i class="bi bi-hand-thumbs-down-fill"></i> Dislike
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Paginación -->
        <div class="row">
            <div class="col-12">
                <nav aria-label="Navegación de personajes">
                    <ul class="pagination justify-content-center">
                        <!-- Botón Primera Página -->
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <button class="page-link btn-edge" @onclick="() => GoToPage(1)" disabled="@(currentPage <= 1)">
                                <i class="bi bi-chevron-double-left"></i>
                            </button>
                        </li>

                        <!-- Botón Anterior -->
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <button class="page-link btn-nav" @onclick="PreviousPage" disabled="@(currentPage <= 1)">
                                <i class="bi bi-chevron-left"></i> Anterior
                            </button>
                        </li>

                        <!-- Números de página -->
                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(pageNum)">
                                    @pageNum
                                </button>
                            </li>
                        }

                        <!-- Botón Siguiente -->
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <button class="page-link btn-nav" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                Siguiente<i class="bi bi-chevron-right"></i> 
                            </button>
                        </li>

                        <!-- Botón Última Página -->
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <button class="page-link btn-edge" @onclick="() => GoToPage(totalPages)" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-chevron-double-right"></i>
                            </button>
                        </li>
                    </ul>
                </nav>

                <p class="text-center text-muted">
                    Página <strong>@currentPage</strong> de <strong>@totalPages</strong> 
                    (@totalCharacters personajes en total)
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            No se encontraron personajes.
        </div>
    }
</div>

@code {
    private List<Character>? characters;
    private bool loading = true;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCharacters = 0;

    // Diccionario para almacenar puntajes
    private Dictionary<int, int> scores = new();

    // 🆕 VARIABLES DE FILTROS
    private string filterName = string.Empty;
    private string filterStatus = string.Empty;
    private string filterSpecies = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCharacters();
    }

    private async Task LoadCharacters()
    {
        loading = true;
        
        try
        {
            ApiResponse<Character>? response;

            // Si hay filtros activos, usar FilterCharactersAsync
            if (!string.IsNullOrEmpty(filterName) || !string.IsNullOrEmpty(filterStatus) || !string.IsNullOrEmpty(filterSpecies))
            {
                response = await ApiService.FilterCharactersAsync(
                    name: string.IsNullOrEmpty(filterName) ? null : filterName,
                    status: string.IsNullOrEmpty(filterStatus) ? null : filterStatus,
                    species: string.IsNullOrEmpty(filterSpecies) ? null : filterSpecies
                );
            }
            else
            {
                // Sin filtros, usar GetCharactersAsync normal
                response = await ApiService.GetCharactersAsync(currentPage);
            }

            if (response != null)
            {
                characters = response.Results;
                totalPages = response.Info.Pages;
                totalCharacters = response.Info.Count;

                // Inicializar puntajes para personajes nuevos
                foreach (var character in characters)
                {
                    if (!scores.ContainsKey(character.Id))
                    {
                        scores[character.Id] = 0;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando personajes: {ex.Message}");
            characters = new List<Character>();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1; // Resetear a página 1 al filtrar
        await LoadCharacters();
    }

    private async Task ClearFilters()
    {
        filterName = string.Empty;
        filterStatus = string.Empty;
        filterSpecies = string.Empty;
        currentPage = 1;
        await LoadCharacters();
    }

    private string GetStatusLabel(string status)
    {
        return status.ToLower() switch
        {
            "alive" => "Vivo",
            "dead" => "Muerto",
            "unknown" => "Desconocido",
            _ => status
        };
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadCharacters();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadCharacters();
        }
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages && page != currentPage)
        {
            currentPage = page;
            await LoadCharacters();
        }
    }

    private void HandleLike(int characterId)
    {
        if (!scores.ContainsKey(characterId))
        {
            scores[characterId] = 0;
        }
        scores[characterId]++;
    }

    private void HandleDislike(int characterId)
    {
        if (!scores.ContainsKey(characterId))
        {
            scores[characterId] = 0;
        }
        scores[characterId]--;
    }

    private int GetScore(int characterId)
    {
        return scores.GetValueOrDefault(characterId, 0);
    }

    private string GetStatusBadgeClass(string status)
    {
        return status.ToLower() switch
        {
            "alive" => "bg-success",
            "dead" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}