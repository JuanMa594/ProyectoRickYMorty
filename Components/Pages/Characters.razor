@page "/characters"
@rendermode InteractiveServer
@using ProyectoRickYMorty.Services;
@using ProyectoRickYMorty.Models;
@inject IRickMortyService ApiService

<PageTitle>Rick Y Morty - Personajes</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="text-center mb-3">
                Personajes <span class="text-primary">Rick</span> Y <span class="text-success">Morty</span>
            </h1>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando personajes...</p>
        </div>
    }
    else if (characters != null && characters.Any())
    {
        <!-- Grid de personajes -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4 mb-4">
            @foreach (var character in characters)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm character-card">
                        <!-- Imagen -->
                        <div class="position-relative">
                            <img src="@character.Image" 
                                 class="card-img-top" 
                                 alt="@character.Name"
                                 loading="lazy">
                            
                            <!-- Badge de estado -->
                            <span class="badge position-absolute top-0 end-0 m-2 @GetStatusBadgeClass(character.Status)">
                                @character.Status
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <!-- Nombre -->
                            <h5 class="card-title text-truncate" title="@character.Name">
                                @character.Name
                            </h5>

                            <!-- Info del personaje -->
                            <div class="mb-3 flex-grow-1">
                                <p class="card-text mb-1">
                                    <small class="text-muted">
                                        <i class="bi bi-geo-alt-fill"></i> 
                                        <strong>Especie:</strong> @character.Species
                                    </small>
                                </p>
                                
                                @if (!string.IsNullOrEmpty(character.Type))
                                {
                                    <p class="card-text mb-1">
                                        <small class="text-muted">
                                            <i class="bi bi-tag-fill"></i> 
                                            <strong>Tipo:</strong> @character.Type
                                        </small>
                                    </p>
                                }

                                <p class="card-text mb-0">
                                    <small class="text-muted">
                                        <i class="bi bi-gender-ambiguous"></i> 
                                        <strong>Género:</strong> @character.Gender
                                    </small>
                                </p>
                            </div>

                            <!-- Puntaje -->
                            <div class="text-center mb-2">
                                <span class="badge bg-secondary fs-6">
                                    Puntaje: @GetScore(character.Id)
                                </span>
                            </div>

                            <!-- Botones Like/Dislike -->
                            <div class="d-flex gap-2">
                                <button class="btn btn-success flex-fill @(HasLiked(character.Id) ? "active" : "")" 
                                        @onclick="() => HandleLike(character.Id)">
                                    <i class="bi bi-hand-thumbs-up-fill"></i> Like
                                </button>
                                <button class="btn btn-danger flex-fill @(HasDisliked(character.Id) ? "active" : "")" 
                                        @onclick="() => HandleDislike(character.Id)">
                                    <i class="bi bi-hand-thumbs-down-fill"></i> Dislike
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Paginación -->
        <div class="row">
            <div class="col-12">
                <nav aria-label="Navegación de personajes">
                    <ul class="pagination justify-content-center">
                        <!-- Botón Primera Página -->
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <button class="page-link btn-edge" @onclick="() => GoToPage(1)" disabled="@(currentPage <= 1)">
                                <i class="bi bi-chevron-double-left"></i>
                            </button>
                        </li>

                        <!-- Botón Anterior -->
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <button class="page-link btn-nav" @onclick="PreviousPage" disabled="@(currentPage <= 1)">
                                <i class="bi bi-chevron-left"></i> Anterior
                            </button>
                        </li>

                        <!-- Números de página -->
                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(pageNum)">
                                    @pageNum
                                </button>
                            </li>
                        }

                        <!-- Botón Siguiente -->
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <button class="page-link btn-nav" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                Siguiente<i class="bi bi-chevron-right"></i> 
                            </button>
                        </li>

                        <!-- Botón Última Página -->
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <button class="page-link btn-edge" @onclick="() => GoToPage(totalPages)" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-chevron-double-right"></i>
                            </button>
                        </li>
                    </ul>
                </nav>

                <p class="text-center text-muted">
                    Página <strong>@currentPage</strong> de <strong>@totalPages</strong> 
                    (@totalCharacters personajes en total)
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            No se encontraron personajes.
        </div>
    }
</div>

@code {
    private List<Character>? characters;
    private bool loading = true;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCharacters = 0;

    // Diccionario para almacenar puntajes (Id del personaje -> puntaje)
    private Dictionary<int, int> scores = new();
    
    // Diccionario para rastrear likes/dislikes (Id del personaje -> "like"/"dislike"/null)
    private Dictionary<int, string?> votes = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCharacters();
    }

    private async Task LoadCharacters()
    {
        loading = true;
        
        try
        {
            var response = await ApiService.GetCharactersAsync(currentPage);

            if (response != null)
            {
                characters = response.Results;
                totalPages = response.Info.Pages;
                totalCharacters = response.Info.Count;

                // Inicializar puntajes para personajes nuevos
                foreach (var character in characters)
                {
                    if (!scores.ContainsKey(character.Id))
                    {
                        scores[character.Id] = 0;
                    }
                    if (!votes.ContainsKey(character.Id))
                    {
                        votes[character.Id] = null;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando personajes: {ex.Message}");
            characters = new List<Character>();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadCharacters();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadCharacters();
        }
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages && page != currentPage)
        {
            currentPage = page;
            await LoadCharacters();
        }
    }

    private void HandleLike(int characterId)
    {
        var currentVote = votes.GetValueOrDefault(characterId);

        if (currentVote == "like")
        {
            // Ya tiene like, remover (toggle)
            votes[characterId] = null;
            scores[characterId]--;
        }
        else if (currentVote == "dislike")
        {
            // Cambiar de dislike a like (serían +2 para que quede positivo el voto)
            votes[characterId] = "like";
            scores[characterId] += 2;
        }
        else
        {
            // No tiene voto, agregar like
            votes[characterId] = "like";
            scores[characterId]++;
        }
    }

    private void HandleDislike(int characterId)
    {
        var currentVote = votes.GetValueOrDefault(characterId);

        if (currentVote == "dislike")
        {
            // Ya tiene dislike, remover (toggle)
            votes[characterId] = null;
            scores[characterId]++;
        }
        else if (currentVote == "like")
        {
            // Cambiar de like a dislike (serían -2, para que quede negativo el voto)
            votes[characterId] = "dislike";
            scores[characterId] -= 2;
        }
        else
        {
            // No tiene voto, agregar dislike
            votes[characterId] = "dislike";
            scores[characterId]--;
        }
    }

    private int GetScore(int characterId)
    {
        return scores.GetValueOrDefault(characterId, 0);
    }

    private bool HasLiked(int characterId)
    {
        return votes.GetValueOrDefault(characterId) == "like";
    }

    private bool HasDisliked(int characterId)
    {
        return votes.GetValueOrDefault(characterId) == "dislike";
    }

    private string GetStatusBadgeClass(string status)
    {
        return status.ToLower() switch
        {
            "alive" => "bg-success",
            "dead" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}